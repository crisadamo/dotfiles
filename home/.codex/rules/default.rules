prefix_rule(pattern=["bun", "install"], decision="allow")
prefix_rule(pattern=["bunx", "vitest"], decision="allow")
prefix_rule(pattern=["swift", "test"], decision="allow")
prefix_rule(pattern=["bunx", "drizzle-kit"], decision="allow")
prefix_rule(pattern=["screencapture", "-x"], decision="allow")
prefix_rule(pattern=["osascript", "-e"], decision="allow")
prefix_rule(pattern=["ps", "-axo"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["codex", "exec", "--help"], decision="allow")
prefix_rule(pattern=["gh", "pr", "view"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["git", "-c", "core.editor=true", "rebase"], decision="allow")
prefix_rule(pattern=["gh", "api"], decision="allow")
prefix_rule(pattern=["bunx", "prettier"], decision="allow")
prefix_rule(pattern=["gh", "auth", "status"], decision="allow", justification="Allow GitHub CLI authentication checks")
