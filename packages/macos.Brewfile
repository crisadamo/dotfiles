# Development
cask 'zed'
cask 'claude'
cask 'chatgpt'
cask 'cursor'
cask 'cursor-cli'
cask 'grok-build'
cask 'claude-code'

cask 'ghostty' # use kero
cask 'tableplus' # use slashpro
cask 'yaak@beta'
brew 'hurl'
brew 'gh'

# Work
brew 'linear-linear'

# Fonts
tap 'homebrew/cask-fonts'
cask 'font-ibm-plex-mono'
cask 'font-ibm-plex-sans'
